digraph ControllerFSM {
    rankdir = UD;
    node [shape = ellipse;];
    
    START;
    PARSE_ARGS;
    HANDLE_ARGS;
    USAGE;
    READ_SHADOW;
    INIT_LISTENER;
    
    WAIT_FOR_WORKER;
    REGISTER_WORKER;
    WAIT_FOR_WORKER_REQUEST;
    VALIDATE_REQUEST;
    
    PREPARE_JOB;
    SEND_CRACK_JOB;
    
    WAIT_FOR_RESULT;
    RECEIVE_RESULTS;
    REPORT_RESULTS;
    
    SEND_HEARTBEAT;
    RECEIVE_HEARTBEAT;
    
    CLEANUP;
    EXIT [shape = doublecircle;];
    
    START -> PARSE_ARGS [label = "parse_arguments";];
    
    PARSE_ARGS -> HANDLE_ARGS [label = "handle_arguments";];
    PARSE_ARGS -> USAGE [label = "usage";];
    
    HANDLE_ARGS -> READ_SHADOW [label = "read_shadow";];
    HANDLE_ARGS -> USAGE [label = "usage";];
    
    READ_SHADOW -> INIT_LISTENER [label = "parse_shadow";];
    READ_SHADOW -> USAGE [label = "usage";];
    
    INIT_LISTENER -> WAIT_FOR_WORKER [label = "listen";];
    
    WAIT_FOR_WORKER -> REGISTER_WORKER [label = "worker_connect";];
    WAIT_FOR_WORKER -> USAGE [label = "error";];
    
    REGISTER_WORKER -> WAIT_FOR_WORKER_REQUEST [label = "registration_success";];
    REGISTER_WORKER -> USAGE [label = "registration_failed";];
    
    WAIT_FOR_WORKER_REQUEST -> VALIDATE_REQUEST [label = "job_request";];
    
    VALIDATE_REQUEST -> PREPARE_JOB [label = "request_valid";];
    VALIDATE_REQUEST -> WAIT_FOR_WORKER_REQUEST [label = "request_invalid";];
    
    PREPARE_JOB -> SEND_CRACK_JOB [label = "job_ready";];
    
    SEND_CRACK_JOB -> WAIT_FOR_RESULT [label = "job_sent";];
    SEND_CRACK_JOB -> USAGE [label = "send_failed";];
    
    WAIT_FOR_RESULT -> RECEIVE_RESULTS [label = "result_received";];
    WAIT_FOR_RESULT -> SEND_HEARTBEAT [label = "heartbeat_interval";];
    WAIT_FOR_RESULT -> USAGE [label = "error";];
    
    SEND_HEARTBEAT -> RECEIVE_HEARTBEAT [label = "heartbeat_ack";];
    SEND_HEARTBEAT -> USAGE [label = "heartbeat_failed";];
    
    RECEIVE_HEARTBEAT -> WAIT_FOR_RESULT [label = "continue_waiting";];
    
    RECEIVE_RESULTS -> REPORT_RESULTS [label = "process_results";];
    RECEIVE_RESULTS -> USAGE [label = "invalid_result";];
    
    REPORT_RESULTS -> CLEANUP [label = "complete";];
    
    USAGE -> CLEANUP [label = "cleanup";];
    
    CLEANUP -> EXIT;
}